# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by the app and by the database container)
PG_DATABASE=expiry_tracker
PG_USER=expiry
PG_PASSWORD=change-me

# Odoo instance the tracker reads from
ODOO_BASE_URL=https://your-company.odoo.com
ODOO_DATABASE=your-database
ODOO_USERNAME=service-account@example.com
ODOO_PASSWORD=change-me

# Origins allowed to call the API, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:8080
